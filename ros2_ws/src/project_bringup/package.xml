<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>project_bringup</name>
  <version>0.1.0</version>
  <description>
    System-level launch files and configuration for the project.
    This package provides unified entry points for all run modes:
    simulation demo, processing only, full system, and bag replay.
  </description>
  <maintainer email="your@email.com">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>project_interfaces</exec_depend>
  <exec_depend>project_simulator</exec_depend>
  <exec_depend>project_processor</exec_depend>
  <exec_depend>project_controller</exec_depend>
  <exec_depend>project_visualizer</exec_depend>
  <exec_depend>experiment_tools</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
